{
  "name": "lewis",
  "version": "1.7.6",
  "description": "李维斯 Lewis 桌面 AI 助手",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test tests/*.test.js",
    "test:voice": ".venv\\Scripts\\python.exe -m unittest discover -s tests -p test_*.py",
    "test:ui": "electron tests/ui.cjs",
    "build": "electron-builder --win portable nsis",
    "build:dir": "electron-builder --win --dir",
    "build:wechat": "node scripts/build-wechat.cjs",
    "build:desktop": "node scripts/build-desktop.cjs"
  },
  "keywords": [],
  "author": "Lewis",
  "license": "ISC",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@phosphor-icons/web": "2.1.2",
    "ajv": "8.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "electron-updater": "6.8.9",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "fingerpose": "0.1.0",
    "ipaddr.js": "^2.5.0",
    "js-tiktoken": "1.0.21",
    "puppeteer-core": "^25.12.0",
    "semver": "7.8.5",
    "undici": "^8.11.2",
    "uuid": "^14.0.2",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "com.lewis.assistant",
    "productName": "Lewis",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json",
      "THIRD-PARTY-1.7.md"
    ],
    "extraResources": [
      {
        "from": "voice-service",
        "to": "voice-service",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "native/WeChatBridge.exe",
        "to": "native/WeChatBridge.exe"
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "DesktopBridge.exe",
          "list-apps.ps1",
          "desktop-ocr.ps1",
          "music-session.ps1"
        ]
      },
      {
        "from": "models/wake",
        "to": "wake-models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "vendor/dafeiyu-pet",
        "to": "dafeiyu/vendor/dafeiyu-pet",
        "filter": [
          "*.py",
          "sprites/**/*",
          "LICENSE",
          "README.md",
          "requirements.txt"
        ]
      },
      {
        "from": "pet-service",
        "to": "dafeiyu/pet-service",
        "filter": [
          "*.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Lewis-${version}-Windows-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "artifactName": "Lewis-${version}-Setup-x64.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2"
  }
}
